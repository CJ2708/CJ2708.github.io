---
import Layout from "../layouts/Layout.astro";
import {
  site,
  about,
  experience,
  aiWork,
  projects,
  skills,
  education,
} from "../data/content";

const resumeHref = site.resume
  ? site.resume.startsWith("http")
    ? site.resume
    : `/${site.resume}`
  : "";

const navItems = [
  { href: "#about", label: "About" },
  { href: "#experience", label: "Experience" },
  { href: "#ai", label: "AI Work" },
  { href: "#projects", label: "Projects" },
  { href: "#skills", label: "Skills" },
  { href: "#contact", label: "Contact" },
];
---

<Layout>
  <!-- Nav -->
  <nav class="nav" id="nav">
    <div class="nav-inner">
      <a href="#top" class="nav-brand">{site.name}</a>
      <button class="nav-toggle" id="navToggle" aria-label="Toggle menu" aria-expanded="false">
        <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
      </button>
      <div class="nav-links" id="navLinks">
        {navItems.map((item) => <a href={item.href}>{item.label}</a>)}
      </div>
    </div>
  </nav>

  <main id="top">
    <!-- Hero -->
    <header class="hero">
      <div class="container">
        <span class="hero-badge"><span class="dot"></span> Open to Data / ML Engineering roles</span>
        <h1>{site.name}</h1>
        <p class="role">{site.role}</p>
        <p class="tagline">{site.tagline}</p>
        <div class="hero-actions">
          <a class="btn btn-primary" href={`mailto:${site.email}`}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 5L2 7"/></svg>
            Email me
          </a>
          <a class="btn" href={site.links.linkedin} target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.32 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.79M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77Z"/></svg>
            LinkedIn
          </a>
          <a class="btn" href={site.links.github} target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12c0 4.42 2.87 8.17 6.84 9.5.5.09.66-.22.66-.48v-1.69c-2.77.6-3.36-1.34-3.36-1.34-.46-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.87 1.52 2.34 1.07 2.91.83.09-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.92 0-1.11.38-2 1.03-2.71-.1-.25-.45-1.29.1-2.64 0 0 .84-.27 2.75 1.02.79-.22 1.65-.33 2.5-.33.85 0 1.71.11 2.5.33 1.91-1.29 2.75-1.02 2.75-1.02.55 1.35.2 2.39.1 2.64.65.71 1.03 1.6 1.03 2.71 0 3.82-2.34 4.66-4.57 4.91.36.31.69.92.69 1.85V21c0 .27.16.59.67.48A10 10 0 0 0 22 12c0-5.52-4.48-10-10-10z"/></svg>
            GitHub
          </a>
          {resumeHref && (
            <a class="btn" href={resumeHref} target="_blank" rel="noopener">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><path d="M7 10l5 5 5-5"/><path d="M12 15V3"/></svg>
              Resume
            </a>
          )}
        </div>
      </div>
    </header>

    <!-- About -->
    <section id="about" class="alt">
      <div class="container reveal">
        <h2 class="section-title">{about.heading}</h2>
        <div class="about-grid">
          <div class="about-text">
            {about.paragraphs.map((p) => <p>{p}</p>)}
          </div>
          <div class="stats">
            {about.highlights.map((h) => (
              <div class="stat">
                <div class="value">{h.value}</div>
                <div class="label">{h.label}</div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Experience -->
    <section id="experience">
      <div class="container reveal">
        <h2 class="section-title">Experience</h2>
        <div class="timeline">
          {experience.map((job) => (
            <article class="job">
              <div class="job-head">
                <div>
                  <div class="job-company">{job.company}</div>
                  <div class="job-role">{job.role}</div>
                </div>
                <div class="job-period">{job.period}</div>
              </div>
              <div class="job-loc">{job.location}</div>
              <ul>
                {job.points.map((pt) => <li>{pt}</li>)}
              </ul>
              <div class="chips">
                {job.stack.map((s) => <span class="chip">{s}</span>)}
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- AI Training & Agent Tooling -->
    <section id="ai" class="alt">
      <div class="container reveal">
        <h2 class="section-title">{aiWork.heading}</h2>
        <p class="ai-intro">{aiWork.intro}</p>
        <div class="ai-grid">
          {aiWork.items.map((item) => (
            <div class="ai-card">
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Projects -->
    <section id="projects">
      <div class="container reveal">
        <h2 class="section-title">Projects</h2>
        <div class="proj-grid">
          {projects.map((proj) => (
            <article class="proj">
              <div class="proj-head">
                <h3>{proj.name}</h3>
                <a class="proj-link" href={proj.link} target="_blank" rel="noopener" aria-label={`Open ${proj.name}`}>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7"/><path d="M7 7h10v10"/></svg>
                </a>
              </div>
              <p>{proj.description}</p>
              <div class="chips">
                {proj.stack.map((s) => <span class="chip">{s}</span>)}
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- Skills -->
    <section id="skills" class="alt">
      <div class="container reveal">
        <h2 class="section-title">Skills</h2>
        <div class="skills-grid">
          {skills.map((group) => (
            <div class="skill-group">
              <h3>{group.group}</h3>
              <div class="skill-list">
                {group.items.map((s) => <span>{s}</span>)}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Education -->
    <section id="education">
      <div class="container reveal">
        <h2 class="section-title">Education</h2>
        <div class="edu">
          <div class="edu-head">
            <div>
              <h3>{education.school}</h3>
              <div class="school-sub">{education.degree}</div>
              <div class="meta">{education.location} · {education.gpa}</div>
            </div>
            <div class="job-period">{education.period}</div>
          </div>
          <ul class="edu-achievements">
            {education.achievements.map((a) => <li>{a}</li>)}
          </ul>
        </div>
      </div>
    </section>

    <!-- Contact -->
    <section id="contact" class="alt contact">
      <div class="container reveal">
        <h2>Let's work together</h2>
        <p>
          I'm open to Data Engineering, ML, and AI infrastructure roles. The fastest way to
          reach me is email — I read everything.
        </p>
        <div class="contact-actions">
          <a class="btn btn-primary" href={`mailto:${site.email}`}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 5L2 7"/></svg>
            {site.email}
          </a>
          <a class="btn" href={site.links.linkedin} target="_blank" rel="noopener">LinkedIn</a>
          <a class="btn" href={site.links.github} target="_blank" rel="noopener">GitHub</a>
          {resumeHref && (
            <a class="btn" href={resumeHref} target="_blank" rel="noopener">Resume</a>
          )}
          <a class="btn" href={`tel:${site.phone.replace(/\s/g, "")}`}>{site.phone}</a>
        </div>
      </div>
    </section>
  </main>

  <footer class="footer">
    <div class="container">
      © {new Date().getFullYear()} {site.name} · Built with Astro · Hosted on GitHub Pages
    </div>
  </footer>

  <script is:inline>
    // Sticky nav shadow on scroll
    const nav = document.getElementById("nav");
    const onScroll = () => nav.classList.toggle("scrolled", window.scrollY > 8);
    onScroll();
    window.addEventListener("scroll", onScroll, { passive: true });

    // Mobile menu toggle
    const toggle = document.getElementById("navToggle");
    const links = document.getElementById("navLinks");
    toggle.addEventListener("click", () => {
      const open = links.classList.toggle("open");
      toggle.setAttribute("aria-expanded", String(open));
    });
    links.querySelectorAll("a").forEach((a) =>
      a.addEventListener("click", () => {
        links.classList.remove("open");
        toggle.setAttribute("aria-expanded", "false");
      })
    );

    // Scroll reveal
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (!reduce && "IntersectionObserver" in window) {
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add("visible");
              io.unobserve(e.target);
            }
          });
        },
        { threshold: 0.12 }
      );
      document.querySelectorAll(".reveal").forEach((el) => io.observe(el));
    } else {
      document.querySelectorAll(".reveal").forEach((el) => el.classList.add("visible"));
    }
  </script>
</Layout>
